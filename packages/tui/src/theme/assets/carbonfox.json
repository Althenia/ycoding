{
  "version": 2,
  "standalone": true,
  "light": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#ffffff",
        "300": "#f4f4f4",
        "400": "#f4f4f4",
        "500": "#afafaf",
        "600": "#6f6f6f",
        "700": "#404040",
        "800": "#161616",
        "900": "#000000"
      },
      "red": {
        "100": "#fef1f4",
        "200": "#fcd0db",
        "300": "#fdabc2",
        "400": "#ef8daa",
        "500": "#db7293",
        "600": "#c7577d",
        "700": "#b33b68",
        "800": "#9f1853",
        "900": "#7f0d40"
      },
      "orange": "$hue.gray",
      "yellow": "$hue.gray",
      "green": {
        "100": "#e1fee4",
        "200": "#bcf0c3",
        "300": "#a3ddab",
        "400": "#8aca93",
        "500": "#71b77c",
        "600": "#57a465",
        "700": "#3c924f",
        "800": "#198038",
        "900": "#166b2e"
      },
      "cyan": {
        "100": "#d7fffc",
        "200": "#b9ece9",
        "300": "#a0d9d5",
        "400": "#86c6c2",
        "500": "#6cb3af",
        "600": "#51a19d",
        "700": "#348f8b",
        "800": "#007d79",
        "900": "#056965"
      },
      "blue": {
        "100": "#f0f5ff",
        "200": "#ccdefe",
        "300": "#a8c5fc",
        "400": "#82adff",
        "500": "#6193f6",
        "600": "#3f79f0",
        "700": "#235fdf",
        "800": "#0043ce",
        "900": "#06369c"
      },
      "purple": "$hue.gray",
      "accent": {
        "100": "#fef1f4",
        "200": "#fcd0db",
        "300": "#fdabc2",
        "400": "#ef8daa",
        "500": "#db7293",
        "600": "#c7577d",
        "700": "#b33b68",
        "800": "#9f1853",
        "900": "#7f0d40"
      },
      "interactive": {
        "100": "#f0f5ff",
        "200": "#ccdefe",
        "300": "#a8c5fc",
        "400": "#82adff",
        "500": "#6193f6",
        "600": "#3f79f0",
        "700": "#235fdf",
        "800": "#0043ce",
        "900": "#06369c"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "red",
      "green",
      "cyan"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#9f1853"
        },
        "warning": {
          "default": "#007d79"
        },
        "success": {
          "default": "#198038"
        },
        "info": {
          "default": "#0043ce"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#9f1853"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#dcdcdc"
    },
    "scrollbar": {
      "default": "#0043ce"
    },
    "diff": {
      "text": {
        "added": "#198038",
        "removed": "#9f1853",
        "context": "#6f6f6f",
        "hunkHeader": "#0043ce"
      },
      "background": {
        "added": "#defbe6",
        "removed": "#fff1f1",
        "context": "#f4f4f4"
      },
      "highlight": {
        "added": "#198038",
        "removed": "#9f1853"
      },
      "lineNumber": {
        "text": "#6f6f6f",
        "background": {
          "added": "#defbe6",
          "removed": "#fff1f1"
        }
      }
    },
    "syntax": {
      "comment": "#6f6f6f",
      "keyword": "#6929c4",
      "function": "#0043ce",
      "variable": "#161616",
      "string": "#198038",
      "number": "#007d79",
      "type": "#007d79",
      "operator": "#525252",
      "punctuation": "#161616"
    },
    "markdown": {
      "text": "#161616",
      "heading": "#0043ce",
      "link": "#0043ce",
      "linkText": "#0072c3",
      "code": "#198038",
      "blockQuote": "#6f6f6f",
      "emphasis": "#6929c4",
      "strong": "#000000",
      "horizontalRule": "#dcdcdc",
      "listItem": "#0072c3",
      "listEnumeration": "#0072c3",
      "image": "#0043ce",
      "imageText": "#0072c3",
      "codeBlock": "#525252"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
