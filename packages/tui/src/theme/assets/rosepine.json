        "500": "#7aacc3",
        "600": "#6299b1",
        "700": "#4a86a0",
        "800": "#31748f",
        "900": "#11627e"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "red",
      "cyan",
      "orange"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#faf4ed",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#faf4ed",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#b4637a"
        },
        "warning": {
          "default": "#ea9d34"
        },
        "success": {
          "default": "#286983"
        },
        "info": {
          "default": "#56949f"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#b4637a"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#dfdad9"
    },
    "scrollbar": {
      "default": "#31748f"
    },
    "diff": {
      "text": {
        "added": "#286983",
        "removed": "#b4637a",
        "context": "#9893a5",
        "hunkHeader": "#907aa9"
      },
      "background": {
        "added": "#e5f2f3",
        "removed": "#fce5e8",
        "context": "#fffaf3"
      },
      "highlight": {
        "added": "#286983",
        "removed": "#b4637a"
      },
      "lineNumber": {
        "text": "#6c6875",
        "background": {
          "added": "#e5f2f3",
          "removed": "#fce5e8"
        }
      }
    },
    "syntax": {
      "comment": "#9893a5",
      "keyword": "#286983",
      "function": "#d7827e",
      "variable": "#575279",
      "string": "#ea9d34",
      "number": "#907aa9",
      "type": "#56949f",
      "operator": "#797593",
      "punctuation": "#797593"
    },
    "markdown": {
      "text": "#575279",
      "heading": "#907aa9",
      "link": "#31748f",
      "linkText": "#d7827e",
      "code": "#286983",
      "blockQuote": "#9893a5",
      "emphasis": "#ea9d34",
      "strong": "#b4637a",
      "horizontalRule": "#dfdad9",
      "listItem": "#31748f",
      "listEnumeration": "#d7827e",
      "image": "#31748f",
      "imageText": "#d7827e",
      "codeBlock": "#575279"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
