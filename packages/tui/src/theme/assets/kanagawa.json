        "500": "#7894a9",
        "600": "#5e7c92",
        "700": "#45657c",
        "800": "#2d4f67",
        "900": "#143a52"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "red",
      "green",
      "orange",
      "cyan"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#f2e9de",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#f2e9de",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#e82424"
        },
        "warning": {
          "default": "#d7a657"
        },
        "success": {
          "default": "#98bb6c"
        },
        "info": {
          "default": "#76946a"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#e82424"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#d4cbbf"
    },
    "scrollbar": {
      "default": "#c38d9d"
    },
    "diff": {
      "text": {
        "added": "#98bb6c",
        "removed": "#e82424",
        "context": "#9e9389",
        "hunkHeader": "#2d4f67"
      },
      "background": {
        "added": "#eaf3e4",
        "removed": "#fbe6e6",
        "context": "#eae4d7"
      },
      "highlight": {
        "added": "#89af5b",
        "removed": "#d61f1f"
      },
      "lineNumber": {
        "text": "#65615c",
        "background": {
          "added": "#dde8d6",
          "removed": "#f2dada"
        }
      }
    },
    "syntax": {
      "comment": "#9e9389",
      "keyword": "#957fb8",
      "function": "#2d4f67",
      "variable": "#54433a",
      "string": "#98bb6c",
      "number": "#d7a657",
      "type": "#c38d9d",
      "operator": "#d27e99",
      "punctuation": "#54433a"
    },
    "markdown": {
      "text": "#54433a",
      "heading": "#957fb8",
      "link": "#2d4f67",
      "linkText": "#76946a",
      "code": "#98bb6c",
      "blockQuote": "#9e9389",
      "emphasis": "#c38d9d",
      "strong": "#d7a657",
      "horizontalRule": "#9e9389",
      "listItem": "#2d4f67",
      "listEnumeration": "#76946a",
      "image": "#2d4f67",
      "imageText": "#76946a",
      "codeBlock": "#54433a"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
