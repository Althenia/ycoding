      },
      "interactive": {
        "100": "#f2f5ff",
        "200": "#d9e1fe",
        "300": "#c0cefd",
        "400": "#a8bafa",
        "500": "#8fa6fc",
        "600": "#7991f8",
        "700": "#637bf7",
        "800": "#5266eb",
        "900": "#4250df"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#b0175f"
        },
        "warning": {
          "default": "#a44200"
        },
        "success": {
          "default": "#036e43"
        },
        "info": {
          "default": "#007f95"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#b0175f"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#7073931a"
    },
    "scrollbar": {
      "default": "#5266eb"
    },
    "diff": {
      "text": {
        "added": "#036e43",
        "removed": "#b0175f",
        "context": "#70707d",
        "hunkHeader": "#70707d"
      },
      "background": {
        "added": "#1885541a",
        "removed": "#d032751a",
        "context": "#fbfcfd"
      },
      "highlight": {
        "added": "#036e43",
        "removed": "#b0175f"
      },
      "lineNumber": {
        "text": "#535461",
        "background": {
          "added": "#1885541a",
          "removed": "#d032751a"
        }
      }
    },
    "syntax": {
      "comment": "#70707d",
      "keyword": "#465bd1",
      "function": "#5266eb",
      "variable": "#007f95",
      "string": "#036e43",
      "number": "#a44200",
      "type": "#007f95",
      "operator": "#465bd1",
      "punctuation": "#363644"
    },
    "markdown": {
      "text": "#363644",
      "heading": "#1e1e2a",
      "link": "#465bd1",
      "linkText": "#5266eb",
      "code": "#036e43",
      "blockQuote": "#70707d",
      "emphasis": "#a44200",
      "strong": "#1e1e2a",
      "horizontalRule": "#7073931a",
      "listItem": "#1e1e2a",
      "listEnumeration": "#5266eb",
      "image": "#465bd1",
      "imageText": "#5266eb",
      "codeBlock": "#363644"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
