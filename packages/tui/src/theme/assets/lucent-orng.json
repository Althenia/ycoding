{
  "version": 2,
  "standalone": true,
  "light": {
    "hue": {
      "gray": {
        "100": "#00000000",
        "200": "#00000000",
        "300": "#00000000",
        "400": "#00000000",
        "500": "#32323280",
        "600": "#8a8a8a",
        "700": "#4e4e4e",
        "800": "#1a1a1a",
        "900": "#000000"
      },
      "red": {
        "100": "#fff2f0",
        "200": "#fed8d5",
        "300": "#fcbeb9",
        "400": "#fda19b",
        "500": "#fc837d",
        "600": "#ee6b68",
        "700": "#e05352",
        "800": "#d1383d",
        "900": "#c20f26"
      },
      "orange": {
        "100": "#fef2ee",
        "200": "#fcdad0",
        "300": "#ffc0ac",
        "400": "#fba68c",
        "500": "#f38e6f",
        "600": "#e67958",
        "700": "#d7633f",
        "800": "#c94d24",
        "900": "#b33e14"
      },
      "yellow": "$hue.gray",
      "green": "$hue.gray",
      "cyan": {
        "100": "#e3fafe",
        "200": "#bfecf4",
        "300": "#a8dbe4",
        "400": "#92c9d4",
        "500": "#7bb8c4",
        "600": "#64a8b4",
        "700": "#4c97a4",
        "800": "#318795",
        "900": "#077786"
      },
      "blue": {
        "100": "#eff6ff",
        "200": "#cfe1fc",
        "300": "#abcdff",
        "400": "#8ab8fb",
        "500": "#64a2fd",
        "600": "#498dee",
        "700": "#2c78e0",
        "800": "#0062d1",
        "900": "#0251ae"
      },
      "purple": "$hue.gray",
      "accent": {
        "100": "#fef2ee",
        "200": "#fcdad0",
        "300": "#ffc0ac",
        "400": "#fba68c",
        "500": "#f38e6f",
        "600": "#e67958",
        "700": "#d7633f",
        "800": "#c94d24",
        "900": "#b33e14"
      },
      "interactive": {
        "100": "#fef2ee",
        "200": "#feded5",
        "300": "#fec9b9",
        "400": "#fcb59f",
        "500": "#fd9e82",
        "600": "#f98866",
        "700": "#f66f45",
        "800": "#ec5b2b",
        "900": "#d94f20"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "red",
      "orange",
      "blue"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#d1383d"
        },
        "warning": {
          "default": "#ec5b2b"
        },
        "success": {
          "default": "#0062d1"
        },
        "info": {
          "default": "#318795"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#d1383d"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#ec5b2b"
    },
    "scrollbar": {
      "default": "#c94d24"
    },
    "diff": {
      "text": {
        "added": "#0062d1",
        "removed": "#c53b53",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#00000000",
        "removed": "#00000000",
        "context": "#00000000"
      },
      "highlight": {
        "added": "#0062d1",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#8a8a8a",
        "background": {
          "added": "#00000000",
          "removed": "#00000000"
        }
      }
    },
    "syntax": {
      "comment": "#8a8a8a",
      "keyword": "#ec5b2b",
      "function": "#c94d24",
      "variable": "#d1383d",
      "string": "#0062d1",
      "number": "#ec5b2b",
      "type": "#b0851f",
      "operator": "#318795",
      "punctuation": "#1a1a1a"
    },
    "markdown": {
      "text": "#1a1a1a",
      "heading": "#ec5b2b",
      "link": "#ec5b2b",
      "linkText": "#318795",
      "code": "#0062d1",
      "blockQuote": "#b0851f",
      "emphasis": "#b0851f",
      "strong": "#ec5b2b",
      "horizontalRule": "#8a8a8a",
      "listItem": "#ec5b2b",
      "listEnumeration": "#318795",
      "image": "#ec5b2b",
      "imageText": "#318795",
      "codeBlock": "#1a1a1a"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
  "dark": {
