        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#bdae93"
    },
    "scrollbar": {
      "default": "#3c3836"
    },
    "diff": {
      "text": {
        "added": "#79740e",
        "removed": "#9d0006",
        "context": "#7c6f64",
        "hunkHeader": "#427b58"
      },
      "background": {
        "added": "#dcd8a4",
        "removed": "#e2c7c3",
        "context": "#ebdbb2"
      },
      "highlight": {
        "added": "#79740e",
        "removed": "#9d0006"
      },
      "lineNumber": {
        "text": "#564f43",
        "background": {
          "added": "#cec99e",
          "removed": "#d3bdb9"
        }
      }
    },
    "syntax": {
      "comment": "#7c6f64",
      "keyword": "#9d0006",
      "function": "#79740e",
      "variable": "#076678",
      "string": "#b57614",
      "number": "#8f3f71",
      "type": "#427b58",
      "operator": "#af3a03",
      "punctuation": "#3c3836"
    },
    "markdown": {
      "text": "#3c3836",
      "heading": "#076678",
      "link": "#427b58",
      "linkText": "#79740e",
      "code": "#b57614",
      "blockQuote": "#7c6f64",
      "emphasis": "#8f3f71",
      "strong": "#af3a03",
      "horizontalRule": "#7c6f64",
      "listItem": "#076678",
      "listEnumeration": "#427b58",
      "image": "#427b58",
      "imageText": "#79740e",
      "codeBlock": "#3c3836"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
