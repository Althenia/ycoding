{
  "version": 2,
  "standalone": true,
  "dark": {
    "hue": {
      "gray": {
        "100": "#f6f1f1",
        "200": "#bfbdb6",
        "300": "#828d8b",
        "400": "#565b66",
        "500": "#2f333c",
        "600": "#0d1017",
        "700": "#0f131a",
        "800": "#0b0e14",
        "900": "#07090e"
      },
      "red": {
        "100": "#f56666",
        "200": "#d95757",
        "300": "#be4849",
        "400": "#a43a3b",
        "500": "#8a2b2d",
        "600": "#711d20",
        "700": "#591014",
        "800": "#420308",
        "900": "#280204"
      },
      "orange": {
        "100": "#ffd49b",
        "200": "#e6b673",
        "300": "#c69b5e",
        "400": "#a78049",
        "500": "#896735",
        "600": "#6c4e22",
        "700": "#51370f",
        "800": "#352204",
        "900": "#1b0f00"
      },
      "yellow": "$hue.gray",
      "green": {
        "100": "#96f977",
        "200": "#7fd962",
        "300": "#69ba4e",
        "400": "#539c3a",
        "500": "#3e8027",
        "600": "#2a6412",
        "700": "#1c4809",
        "800": "#0d2f01",
        "900": "#051701"
      },
      "cyan": {
        "100": "#5fd4ff",
        "200": "#39bae6",
        "300": "#26a0c8",
        "400": "#1086aa",
        "500": "#166d89",
        "600": "#13556b",
        "700": "#0b3e4f",
        "800": "#032835",
        "900": "#01141d"
      },
      "blue": {
        "100": "#a4dafd",
        "200": "#59c2ff",
        "300": "#46a6dd",
        "400": "#328bbc",
        "500": "#1e719d",
        "600": "#07587e",
        "700": "#03405d",
        "800": "#04293c",
        "900": "#001420"
      },
      "purple": {
        "100": "#e4cefd",
        "200": "#d2a6ff",
        "300": "#b48cdd",
        "400": "#9774bb",
        "500": "#7c5c9b",
        "600": "#61457c",
        "700": "#472f5e",
        "800": "#2f1a42",
        "900": "#190728"
      },
      "accent": {
        "100": "#fed27f",
        "200": "#e6b450",
        "300": "#c6993d",
        "400": "#a77f2a",
        "500": "#8a6615",
        "600": "#6a4e11",
        "700": "#4e3808",
        "800": "#332301",
        "900": "#191001"
      },
      "interactive": {
        "100": "#a4dafd",
        "200": "#59c2ff",
        "300": "#46a6dd",
        "400": "#328bbc",
        "500": "#1e719d",
        "600": "#07587e",
        "700": "#03405d",
        "800": "#04293c",
        "900": "#001420"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.200",
      "subdued": "$hue.neutral.400",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.400",
          "$focused": "#0b0e14",
          "$selected": "$hue.interactive.200"
        },
        "destructive": {
          "default": "#0b0e14",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "default": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "default": "#d95757"
        },
        "warning": {
          "default": "#e6b673"
        },
        "success": {
          "default": "#7fd962"
        },
        "info": {
          "default": "#39bae6"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.800",
      "surface": {
        "offset": "$hue.neutral.700",
        "overlay": "$hue.neutral.600"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#d95757"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#6c7380"
    },
    "scrollbar": {
      "default": "#6c7380"
    },
    "diff": {
      "text": {
        "added": "#7fd962",
        "removed": "#f26d78",
        "context": "#acb6bf",
        "hunkHeader": "#acb6bf"
      },
      "background": {
        "added": "#20303b",
        "removed": "#37222c",
        "context": "#0f131a"
      },
      "highlight": {
        "added": "#aad94c",
        "removed": "#f07178"
      },
      "lineNumber": {
        "text": "#acb6bf",
        "background": {
          "added": "#1b2b34",
          "removed": "#2d1f26"
        }
      }
    },
    "syntax": {
      "comment": "#acb6bf",
      "keyword": "#ff8f40",
      "function": "#ffb454",
      "variable": "#59c2ff",
      "string": "#aad94c",
      "number": "#d2a6ff",
      "type": "#e6b673",
      "operator": "#f29668",
      "punctuation": "#bfbdb6"
    },
    "markdown": {
      "text": "#bfbdb6",
      "heading": "#d2a6ff",
      "link": "#59c2ff",
      "linkText": "#39bae6",
      "code": "#aad94c",
      "blockQuote": "#e6b673",
      "emphasis": "#e6b673",
      "strong": "#ffb454",
      "horizontalRule": "#565b66",
      "listItem": "#59c2ff",
      "listEnumeration": "#39bae6",
      "image": "#59c2ff",
      "imageText": "#39bae6",
      "codeBlock": "#bfbdb6"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  }
}
