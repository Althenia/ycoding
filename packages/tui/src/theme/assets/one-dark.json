          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#d1d1d2"
    },
    "scrollbar": {
      "default": "#4078f2"
    },
    "diff": {
      "text": {
        "added": "#50a14f",
        "removed": "#e45649",
        "context": "#a0a1a7",
        "hunkHeader": "#0184bc"
      },
      "background": {
