      "listEnumeration": "#0184bc",
      "image": "#4078f2",
      "imageText": "#0184bc",
      "codeBlock": "#383a42"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
