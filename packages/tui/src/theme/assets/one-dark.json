        "text": "#666666",
        "background": {
          "added": "#e1f3df",
          "removed": "#f5e2e1"
        }
      }
    },
    "syntax": {
      "comment": "#a0a1a7",
      "keyword": "#a626a4",
      "function": "#4078f2",
      "variable": "#e45649",
      "string": "#50a14f",
      "number": "#986801",
      "type": "#c18401",
      "operator": "#0184bc",
      "punctuation": "#383a42"
    },
    "markdown": {
      "text": "#383a42",
      "heading": "#a626a4",
      "link": "#4078f2",
      "linkText": "#0184bc",
      "code": "#50a14f",
      "blockQuote": "#a0a1a7",
      "emphasis": "#c18401",
      "strong": "#986801",
