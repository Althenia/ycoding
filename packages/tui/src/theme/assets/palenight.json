        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#e0e0e0"
    },
    "scrollbar": {
      "default": "#4976eb"
    },
    "diff": {
      "text": {
        "added": "#91b859",
        "removed": "#e53935",
        "context": "#8796b0",
        "hunkHeader": "#00acc1"
      },
      "background": {
        "added": "#e8f5e9",
        "removed": "#ffebee",
        "context": "#f5f5f5"
      },
      "highlight": {
        "added": "#91b859",
        "removed": "#e53935"
      },
      "lineNumber": {
        "text": "#6a6e70",
        "background": {
          "added": "#e8f5e9",
          "removed": "#ffebee"
        }
      }
    },
    "syntax": {
      "comment": "#8796b0",
      "keyword": "#a854f2",
      "function": "#4976eb",
      "variable": "#292d3e",
      "string": "#91b859",
      "number": "#f4511e",
      "type": "#ffb300",
      "operator": "#00acc1",
      "punctuation": "#292d3e"
    },
    "markdown": {
      "text": "#292d3e",
      "heading": "#a854f2",
      "link": "#4976eb",
      "linkText": "#00acc1",
      "code": "#91b859",
      "blockQuote": "#8796b0",
      "emphasis": "#ffb300",
      "strong": "#f4511e",
      "horizontalRule": "#8796b0",
      "listItem": "#4976eb",
      "listEnumeration": "#00acc1",
      "image": "#4976eb",
      "imageText": "#00acc1",
      "codeBlock": "#292d3e"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
