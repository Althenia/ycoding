        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#d1d1d2"
    },
    "scrollbar": {
      "default": "#a0a1a7"
    },
    "diff": {
      "text": {
        "added": "#50a14f",
        "removed": "#ca1243",
        "context": "#a0a1a7",
        "hunkHeader": "#0184bc"
      },
      "background": {
        "added": "#eafbe9",
        "removed": "#fce9ee",
        "context": "#f0f0f1"
      },
      "highlight": {
        "added": "#489447",
        "removed": "#b00f3a"
      },
      "lineNumber": {
        "text": "#696c77",
        "background": {
          "added": "#e1f3df",
          "removed": "#f5e2e7"
        }
      }
    },
    "syntax": {
      "comment": "#a0a1a7",
      "keyword": "#a626a4",
      "function": "#4078f2",
      "variable": "#ca1243",
      "string": "#50a14f",
      "number": "#d75f00",
      "type": "#c18401",
      "operator": "#0184bc",
      "punctuation": "#383a42"
    },
    "markdown": {
      "text": "#383a42",
      "heading": "#ca1243",
      "link": "#a626a4",
      "linkText": "#4078f2",
      "code": "#50a14f",
      "blockQuote": "#a0a1a7",
      "emphasis": "#a626a4",
      "strong": "#d75f00",
      "horizontalRule": "#a0a1a7",
      "listItem": "#c18401",
      "listEnumeration": "#c18401",
      "image": "#a626a4",
      "imageText": "#4078f2",
      "codeBlock": "#383a42"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
