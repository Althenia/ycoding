        }
      }
    },
    "syntax": {
      "comment": "#53685b",
      "keyword": "#2dd5b7",
      "function": "#509475",
      "variable": "#c1c497",
      "string": "#63b07a",
      "number": "#d2689c",
      "type": "#549e6a",
      "operator": "#459451",
      "punctuation": "#c1c497"
    },
    "markdown": {
      "text": "#c1c497",
      "heading": "#2dd5b7",
      "link": "#8cd3cb",
      "linkText": "#549e6a",
      "code": "#63b07a",
      "blockQuote": "#53685b",
      "emphasis": "#d2689c",
      "strong": "#c1c497",
      "horizontalRule": "#53685b",
      "listItem": "#2dd5b7",
      "listEnumeration": "#8cd3cb",
      "image": "#8cd3cb",
      "imageText": "#549e6a",
      "codeBlock": "#c1c497"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
