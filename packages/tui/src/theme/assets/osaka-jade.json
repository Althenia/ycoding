      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#ff5345"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#3d4a44"
    },
    "scrollbar": {
      "default": "#2dd5b7"
    },
    "diff": {
      "text": {
        "added": "#549e6a",
        "removed": "#ff5345",
        "context": "#53685b",
        "hunkHeader": "#2dd5b7"
      },
      "background": {
        "added": "#15241c",
