{
  "version": 2,
  "standalone": true,
  "light": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#fcfcfc",
        "300": "#f3f3f3",
        "400": "#ededed",
        "500": "#777777d6",
        "600": "#141414ad",
        "700": "#141414d6",
        "800": "#141414",
        "900": "#141414"
      },
      "red": {
        "100": "#fff1f2",
        "200": "#fed7da",
        "300": "#fcbcc2",
        "400": "#fd9ea9",
        "500": "#fb7d90",
        "600": "#ed657c",
        "700": "#de4b69",
        "800": "#cf2d56",
        "900": "#b81947"
      },
      "orange": "$hue.gray",
      "yellow": "$hue.gray",
      "green": {
        "100": "#ddfeee",
        "200": "#bcf0d7",
        "300": "#a4dec3",
        "400": "#8ccdb0",
        "500": "#74bc9c",
        "600": "#5bab89",
        "700": "#419a77",
        "800": "#1f8a65",
        "900": "#057855"
      },
      "cyan": {
        "100": "#e5f9ff",
        "200": "#d2ecf3",
        "300": "#c1dee5",
        "400": "#b0d0d9",
        "500": "#a0c3cc",
        "600": "#8fb5bf",
        "700": "#7fa8b2",
        "800": "#6f9ba6",
        "900": "#5f8e9a"
      },
      "blue": "$hue.gray",
      "purple": "$hue.gray",
      "accent": {
        "100": "#e5f9ff",
        "200": "#d2ecf3",
        "300": "#c1dee5",
        "400": "#b0d0d9",
        "500": "#a0c3cc",
        "600": "#8fb5bf",
        "700": "#7fa8b2",
        "800": "#6f9ba6",
        "900": "#5f8e9a"
      },
      "interactive": {
        "100": "#e5f9ff",
        "200": "#d2ecf3",
        "300": "#c1dee5",
        "400": "#b0d0d9",
        "500": "#a0c3cc",
        "600": "#8fb5bf",
        "700": "#7fa8b2",
        "800": "#6f9ba6",
        "900": "#5f8e9a"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "cyan",
      "green",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#fcfcfc",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#fcfcfc",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#cf2d56"
        },
        "warning": {
          "default": "#db704b"
        },
        "success": {
          "default": "#1f8a65"
        },
        "info": {
          "default": "#3c7cab"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#cf2d56"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#14141413"
    },
    "scrollbar": {
      "default": "#6f9ba6"
    },
    "diff": {
      "text": {
        "added": "#1f8a65",
        "removed": "#cf2d56",
        "context": "#141414ad",
        "hunkHeader": "#141414ad"
      },
      "background": {
        "added": "#1f8a651f",
        "removed": "#cf2d5614",
        "context": "#f3f3f3"
      },
      "highlight": {
        "added": "#55a583",
        "removed": "#e75e78"
      },
      "lineNumber": {
        "text": "#141414ad",
        "background": {
          "added": "#1f8a651f",
          "removed": "#cf2d5614"
        }
      }
    },
    "syntax": {
      "comment": "#141414ad",
      "keyword": "#b3003f",
      "function": "#db704b",
      "variable": "#141414",
      "string": "#9e94d5",
      "number": "#b8448b",
      "type": "#206595",
      "operator": "#141414",
      "punctuation": "#141414"
    },
    "markdown": {
      "text": "#141414",
      "heading": "#206595",
      "link": "#206595",
      "linkText": "#141414ad",
      "code": "#1f8a65",
      "blockQuote": "#141414ad",
      "emphasis": "#141414",
      "strong": "#141414",
      "horizontalRule": "#141414ad",
      "listItem": "#141414",
      "listEnumeration": "#141414ad",
      "image": "#206595",
      "imageText": "#141414ad",
      "codeBlock": "#141414"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
