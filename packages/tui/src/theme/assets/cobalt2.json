        "900": "#6f2df4"
      },
      "accent": {
        "100": "#e3faff",
        "200": "#b9f3fe",
        "300": "#9ee8f6",
        "400": "#88dceb",
        "500": "#71d0e1",
        "600": "#58c4d6",
        "700": "#3bb8cb",
        "800": "#00acc1",
        "900": "#259daf"
      },
      "interactive": {
        "100": "#eff6fe",
        "200": "#cee2fd",
        "300": "#abcefc",
        "400": "#85b9ff",
        "500": "#65a5f8",
        "600": "#4a90e9",
        "700": "#2d7bdb",
        "800": "#0066cc",
        "900": "#0255aa"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "cyan",
      "green",
      "orange",
      "blue",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#e91e63"
        },
        "warning": {
          "default": "#ff9800"
        },
        "success": {
          "default": "#4caf50"
        },
        "info": {
          "default": "#ff5722"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#e91e63"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#d3dae3"
    },
    "scrollbar": {
      "default": "#0066cc"
    },
    "diff": {
      "text": {
        "added": "#4caf50",
        "removed": "#e91e63",
        "context": "#5c6b7d",
        "hunkHeader": "#00acc1"
      },
      "background": {
        "added": "#e8f5e9",
        "removed": "#ffebee",
        "context": "#f5f7fa"
      },
      "highlight": {
        "added": "#4caf50",
        "removed": "#e91e63"
      },
      "lineNumber": {
        "text": "#5c6b7d",
        "background": {
          "added": "#e8f5e9",
          "removed": "#ffebee"
        }
      }
    },
    "syntax": {
      "comment": "#5c6b7d",
      "keyword": "#ff5722",
      "function": "#ff9800",
      "variable": "#193549",
      "string": "#4caf50",
      "number": "#e91e63",
      "type": "#00acc1",
      "operator": "#ff5722",
      "punctuation": "#193549"
    },
    "markdown": {
      "text": "#193549",
      "heading": "#ff9800",
      "link": "#0066cc",
      "linkText": "#00acc1",
      "code": "#4caf50",
      "blockQuote": "#5c6b7d",
      "emphasis": "#ff5722",
      "strong": "#e91e63",
      "horizontalRule": "#d3dae3",
      "listItem": "#0066cc",
      "listEnumeration": "#00acc1",
      "image": "#0066cc",
      "imageText": "#00acc1",
      "codeBlock": "#193549"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
