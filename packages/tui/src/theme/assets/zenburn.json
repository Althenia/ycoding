          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#d0d0c0"
    },
    "scrollbar": {
      "default": "#5f7f8f"
    },
    "diff": {
      "text": {
        "added": "#5f8f5f",
        "removed": "#8f5f5f",
        "context": "#6f6f6f",
        "hunkHeader": "#5f8f8f"
      },
      "background": {
        "added": "#efffef",
        "removed": "#ffefef",
        "context": "#f5f5e5"
      },
      "highlight": {
        "added": "#5f8f5f",
        "removed": "#8f5f5f"
      },
      "lineNumber": {
        "text": "#6f6f6f",
        "background": {
          "added": "#efffef",
          "removed": "#ffefef"
        }
      }
    },
    "syntax": {
      "comment": "#5f7f5f",
      "keyword": "#8f8f5f",
      "function": "#5f7f8f",
      "variable": "#3f3f3f",
      "string": "#8f5f5f",
      "number": "#5f8f5f",
      "type": "#5f8f8f",
      "operator": "#8f8f5f",
      "punctuation": "#3f3f3f"
    },
    "markdown": {
      "text": "#3f3f3f",
      "heading": "#8f8f5f",
      "link": "#5f7f8f",
      "linkText": "#5f8f8f",
      "code": "#5f8f5f",
      "blockQuote": "#6f6f6f",
      "emphasis": "#8f8f5f",
      "strong": "#8f7f5f",
      "horizontalRule": "#6f6f6f",
      "listItem": "#5f7f8f",
      "listEnumeration": "#5f8f8f",
      "image": "#5f7f8f",
      "imageText": "#5f8f8f",
      "codeBlock": "#3f3f3f"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
