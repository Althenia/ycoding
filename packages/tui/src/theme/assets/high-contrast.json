      },
      "red": {
        "100": "#f6ebeb",
        "200": "#e8cccc",
        "300": "#d8abab",
        "400": "#c78585",
        "500": "#b66161",
        "600": "#a74040",
        "700": "#981f1f",
        "800": "#8a0000",
        "900": "#7c0000"
      },
      "orange": {
        "100": "#f3efeb",
