        "400": "#85a3c5",
        "500": "#6188b5",
        "600": "#406fa5",
        "700": "#1f5695",
        "800": "#003f87",
        "900": "#00397a"
      },
      "purple": {
        "100": "#f3ebf6",
        "200": "#e2cce9",
        "300": "#cfabdb",
        "400": "#b985ca",
        "500": "#a461bb",
        "600": "#9240ac",
        "700": "#7f1f9e",
        "800": "#6d0091",
        "900": "#620082"
      },
      "accent": "$hue.cyan",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "cyan",
      "green",
      "orange",
      "blue",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.700",
      "separator": "$hue.neutral.600",
      "hint": "$hue.neutral.700",
      "label": "$hue.neutral.700",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#8a0000"
        },
        "warning": {
          "default": "#4c4000"
        },
        "success": {
          "default": "#004c06"
        },
        "info": {
          "default": "#003f87"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#8a0000"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#595959"
    },
    "scrollbar": {
      "default": "#595959"
    },
    "diff": {
      "text": {
        "added": "#004c06",
        "removed": "#8a0000",
        "context": "#404040",
        "hunkHeader": "#00484f"
      },
      "background": {
        "added": "#e6ede6",
        "removed": "#f3e6e6",
        "context": "#f0f0f0"
      },
      "highlight": {
        "added": "#004c06",
        "removed": "#8a0000"
      },
      "lineNumber": {
        "text": "#404040",
        "background": {
          "added": "#e0eae1",
          "removed": "#f1e0e0"
        }
      }
    },
    "syntax": {
      "comment": "#404040",
      "keyword": "#6d0091",
      "function": "#003f87",
      "variable": "#8a0000",
      "string": "#004c06",
      "number": "#6b3200",
      "type": "#4c4000",
      "operator": "#00484f",
      "punctuation": "#000000"
    },
    "markdown": {
      "text": "#000000",
      "heading": "#6d0091",
      "link": "#003f87",
      "linkText": "#00484f",
      "code": "#004c06",
      "blockQuote": "#404040",
      "emphasis": "#4c4000",
      "strong": "#6b3200",
      "horizontalRule": "#404040",
      "listItem": "#003f87",
      "listEnumeration": "#00484f",
      "image": "#003f87",
      "imageText": "#00484f",
      "codeBlock": "#000000"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
