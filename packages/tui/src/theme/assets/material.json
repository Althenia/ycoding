        "500": "#97b3df",
        "600": "#85a2d2",
        "700": "#7392c5",
        "800": "#6182b8",
        "900": "#5072ab"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "cyan",
      "green",
      "orange",
      "blue",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#fafafa",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#fafafa",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#e53935"
        },
        "warning": {
          "default": "#ffb300"
        },
        "success": {
          "default": "#91b859"
        },
        "info": {
          "default": "#f4511e"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#e53935"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#e0e0e0"
    },
    "scrollbar": {
      "default": "#6182b8"
    },
    "diff": {
      "text": {
        "added": "#91b859",
        "removed": "#e53935",
        "context": "#90a4ae",
        "hunkHeader": "#39adb5"
      },
      "background": {
        "added": "#e8f5e9",
        "removed": "#ffebee",
        "context": "#f5f5f5"
      },
      "highlight": {
        "added": "#91b859",
        "removed": "#e53935"
      },
      "lineNumber": {
        "text": "#6a6e70",
        "background": {
          "added": "#e8f5e9",
          "removed": "#ffebee"
        }
      }
    },
    "syntax": {
      "comment": "#90a4ae",
      "keyword": "#7c4dff",
      "function": "#6182b8",
      "variable": "#263238",
      "string": "#91b859",
      "number": "#f4511e",
      "type": "#ffb300",
      "operator": "#39adb5",
      "punctuation": "#263238"
    },
    "markdown": {
      "text": "#263238",
      "heading": "#6182b8",
      "link": "#39adb5",
      "linkText": "#7c4dff",
      "code": "#91b859",
      "blockQuote": "#90a4ae",
      "emphasis": "#ffb300",
      "strong": "#f4511e",
      "horizontalRule": "#e0e0e0",
      "listItem": "#6182b8",
      "listEnumeration": "#39adb5",
      "image": "#39adb5",
      "imageText": "#7c4dff",
      "codeBlock": "#263238"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
