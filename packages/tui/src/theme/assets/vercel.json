        "700": "#9e64d4",
        "800": "#8e4ec6",
        "900": "#7e36b8"
      },
      "accent": {
        "100": "#f8f2ff",
        "200": "#eadafd",
        "300": "#dcc0fb",
        "400": "#d0a5fe",
        "500": "#bf8ff0",
        "600": "#ae7ae2",
        "700": "#9e64d4",
        "800": "#8e4ec6",
        "900": "#7e36b8"
      },
      "interactive": {
        "100": "#f0f6fe",
        "200": "#d3e4fd",
        "300": "#b6d2fc",
        "400": "#96c0fe",
        "500": "#7aadf9",
        "600": "#5599ff",
        "700": "#2e84fe",
        "800": "#0070f3",
        "900": "#0b62d0"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "purple",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#ffffff",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#ffffff",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#dc3545"
        },
        "warning": {
          "default": "#ff9500"
        },
        "success": {
          "default": "#388e3c"
        },
        "info": {
          "default": "#0070f3"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#dc3545"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#eaeaea"
    },
    "scrollbar": {
      "default": "#999999"
    },
    "diff": {
      "text": {
        "added": "#46a758",
        "removed": "#e5484d",
        "context": "#666666",
        "hunkHeader": "#666666"
      },
      "background": {
        "added": "#e6f9e9",
        "removed": "#fdeced",
        "context": "#ffffff"
      },
      "highlight": {
        "added": "#46a758",
        "removed": "#e5484d"
      },
      "lineNumber": {
        "text": "#666666",
        "background": {
          "added": "#d6f5d6",
          "removed": "#ffe5e5"
        }
      }
    },
    "syntax": {
      "comment": "#888888",
      "keyword": "#e93d82",
      "function": "#8e4ec6",
      "variable": "#0070f3",
      "string": "#46a758",
      "number": "#ffb224",
      "type": "#12a594",
      "operator": "#e93d82",
      "punctuation": "#171717"
    },
    "markdown": {
      "text": "#171717",
      "heading": "#8e4ec6",
      "link": "#0070f3",
      "linkText": "#12a594",
      "code": "#46a758",
      "blockQuote": "#666666",
      "emphasis": "#ffb224",
      "strong": "#e93d82",
      "horizontalRule": "#999999",
      "listItem": "#171717",
      "listEnumeration": "#0070f3",
      "image": "#12a594",
      "imageText": "#12a594",
      "codeBlock": "#171717"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
