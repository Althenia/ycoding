        "500": "#a6a6a6",
        "600": "#666666",
        "700": "#3c3c3c",
        "800": "#171717",
        "900": "#000000"
      },
      "red": {
        "100": "#fef2f1",
        "200": "#fdd9d8",
        "300": "#fcc0be",
        "400": "#fda5a3",
        "500": "#fd8787",
        "600": "#f76a6e",
        "700": "#ea5259",
