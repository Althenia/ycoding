        "500": "#82b2f9",
        "600": "#5ea0ff",
        "700": "#478ff4",
        "800": "#2e7de9",
        "900": "#0a6bde"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "yellow",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#e1e2e7",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#e1e2e7",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#f52a65"
        },
        "warning": {
          "default": "#b15c00"
        },
        "success": {
          "default": "#587539"
        },
        "info": {
          "default": "#2e7de9"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#f52a65"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#737a8c"
    },
    "scrollbar": {
      "default": "#5a607d"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "removed": "#c53b53",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db",
        "context": "#d5d6db"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#59595b",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "comment": "#8990a3",
      "keyword": "#9854f1",
      "function": "#2e7de9",
      "variable": "#f52a65",
      "string": "#587539",
      "number": "#b15c00",
      "type": "#8c6c3e",
      "operator": "#007197",
      "punctuation": "#3760bf"
    },
    "markdown": {
      "text": "#3760bf",
      "heading": "#9854f1",
      "link": "#2e7de9",
      "linkText": "#007197",
      "code": "#587539",
      "blockQuote": "#8c6c3e",
      "emphasis": "#8c6c3e",
      "strong": "#b15c00",
      "horizontalRule": "#8990a3",
      "listItem": "#2e7de9",
      "listEnumeration": "#007197",
      "image": "#2e7de9",
      "imageText": "#007197",
      "codeBlock": "#3760bf"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
