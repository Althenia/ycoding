        "500": "#b6c869",
        "600": "#a8bb51",
        "700": "#9aae35",
        "800": "#8da101",
        "900": "#81931f"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "blue",
      "purple",
      "yellow",
      "orange",
      "red"
    ],
    "text": {
      "default": "$hue.neutral.800",
      "subdued": "$hue.neutral.600",
      "action": {
        "primary": {
          "default": "$text.default",
          "$disabled": "$hue.neutral.600",
          "$focused": "#fdf6e3",
          "$selected": "$hue.interactive.800"
        },
        "destructive": {
          "default": "#fdf6e3",
          "$disabled": "$hue.neutral.600"
        }
      },
      "formfield": {
        "default": "$hue.neutral.800",
        "$hovered": "$hue.interactive.800",
        "$focused": "$hue.interactive.800",
        "$pressed": "$hue.interactive.800",
        "$disabled": "$hue.neutral.600",
        "$selected": "$hue.interactive.800"
      },
      "feedback": {
        "error": {
          "default": "#f85552"
        },
        "warning": {
          "default": "#f57d26"
        },
        "success": {
          "default": "#8da101"
        },
        "info": {
          "default": "#35a77c"
        }
      }
    },
    "background": {
      "default": "$hue.neutral.200",
      "surface": {
        "offset": "$hue.neutral.300",
        "overlay": "$hue.neutral.400"
      },
      "action": {
        "primary": {
          "default": "transparent",
          "$hovered": "$hue.neutral.300",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "destructive": {
          "default": "#f85552"
        }
      },
      "formfield": {
        "default": "$background.default"
      },
      "feedback": {
        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#939f91"
    },
    "scrollbar": {
      "default": "#829181"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "removed": "#c53b53",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db",
        "context": "#efebd4"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#5b5951",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "comment": "#a6b0a0",
      "keyword": "#df69ba",
      "function": "#8da101",
      "variable": "#f85552",
      "string": "#8da101",
      "number": "#f57d26",
      "type": "#dfa000",
      "operator": "#35a77c",
      "punctuation": "#5c6a72"
    },
    "markdown": {
      "text": "#5c6a72",
      "heading": "#df69ba",
      "link": "#8da101",
      "linkText": "#35a77c",
      "code": "#8da101",
      "blockQuote": "#dfa000",
      "emphasis": "#dfa000",
      "strong": "#f57d26",
      "horizontalRule": "#a6b0a0",
      "listItem": "#8da101",
      "listEnumeration": "#35a77c",
      "image": "#8da101",
      "imageText": "#35a77c",
      "codeBlock": "#5c6a72"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
  },
