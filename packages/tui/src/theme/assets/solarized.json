        "error": {
          "default": "$background.default"
        },
        "warning": {
          "default": "$background.default"
        },
        "success": {
          "default": "$background.default"
        },
        "info": {
          "default": "$background.default"
        }
      }
    },
    "border": {
      "default": "#eee8d5"
    },
    "scrollbar": {
      "default": "#93a1a1"
    },
    "diff": {
      "text": {
        "added": "#859900",
        "removed": "#dc322f",
        "context": "#93a1a1",
        "hunkHeader": "#93a1a1"
      },
      "background": {
        "added": "#eee8d5",
        "removed": "#eee8d5",
        "context": "#eee8d5"
      },
      "highlight": {
        "added": "#859900",
        "removed": "#dc322f"
      },
      "lineNumber": {
        "text": "#5f6969",
        "background": {
          "added": "#eee8d5",
          "removed": "#eee8d5"
        }
      }
    },
    "syntax": {
      "comment": "#93a1a1",
      "keyword": "#859900",
      "function": "#268bd2",
      "variable": "#2aa198",
      "string": "#2aa198",
      "number": "#d33682",
      "type": "#b58900",
      "operator": "#859900",
      "punctuation": "#657b83"
    },
    "markdown": {
      "text": "#657b83",
      "heading": "#268bd2",
      "link": "#2aa198",
      "linkText": "#6c71c4",
      "code": "#859900",
      "blockQuote": "#93a1a1",
      "emphasis": "#b58900",
      "strong": "#cb4b16",
      "horizontalRule": "#93a1a1",
      "listItem": "#268bd2",
      "listEnumeration": "#2aa198",
      "image": "#2aa198",
      "imageText": "#6c71c4",
      "codeBlock": "#657b83"
    },
    "@context:elevated": {
      "background": {
        "default": "$background.surface.offset",
        "action": {
          "primary": {
            "$hovered": "$background.surface.overlay"
          }
        }
      }
    },
    "@context:overlay": {
      "background": {
        "default": "$background.surface.overlay"
      }
    }
