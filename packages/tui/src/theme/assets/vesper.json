        "900": "#1e0d01"
      },
      "interactive": {
        "100": "#fef2e8",
        "200": "#ffc799",
        "300": "#dba97f",
        "400": "#b88b66",
        "500": "#976f4e",
        "600": "#765437",
        "700": "#573a21",
        "800": "#3a220c",
        "900": "#1e0d01"
      },
      "neutral": "$hue.gray"
    },
    "categorical": [
      "green",
