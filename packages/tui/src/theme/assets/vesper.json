    },
    "markdown": {
      "text": "#ffffff",
      "heading": "#ffc799",
      "link": "#ffc799",
      "linkText": "#a0a0a0",
      "code": "#a0a0a0",
      "blockQuote": "#ffffff",
      "emphasis": "#ffffff",
      "strong": "#ffffff",
      "horizontalRule": "#65737e",
      "listItem": "#ffffff",
      "listEnumeration": "#ffffff",
      "image": "#ffc799",
