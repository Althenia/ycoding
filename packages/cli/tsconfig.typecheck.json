{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  // The CLI pulls in TUI sources, so it needs the TUI's ambient asset declarations too.
  "include": ["**/*", "../tui/src/image.d.ts"],
  "compilerOptions": {
    "paths": {
      "@opentui/core": ["../../vendor/opentui/packages/core/dist/index.d.ts"],
      "@opentui/core/*": ["../../vendor/opentui/packages/core/dist/*"],
      "@opentui/keymap": ["../../vendor/opentui/packages/keymap/dist/index.d.ts"],
      "@opentui/keymap/*": ["../../vendor/opentui/packages/keymap/dist/*"],
      "@opentui/solid": ["../../vendor/opentui/packages/solid/dist/index.d.ts"],
      "@opentui/solid/*": ["../../vendor/opentui/packages/solid/dist/*"]
    }
  }
}
