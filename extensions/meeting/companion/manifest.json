{
  "manifest_version": 3,
  "name": "YCoding Meet capture",
  "description": "Explicitly consented Google Meet audio capture for the authenticated local YCoding meeting runtime.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/ycoding-16.png",
    "32": "icons/ycoding-32.png",
    "48": "icons/ycoding-48.png",
    "128": "icons/ycoding-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YCoding Meet capture",
    "default_icon": {
      "16": "icons/ycoding-16.png",
      "32": "icons/ycoding-32.png",
      "48": "icons/ycoding-48.png",
      "128": "icons/ycoding-128.png"
    }
  },
  "commands": {
    "stop-capture": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Stop YCoding Meet capture"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:*; style-src 'self'; font-src 'self' data:"
  }
}
