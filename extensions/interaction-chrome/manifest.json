{
  "manifest_version": 3,
  "name": "YCoding Interaction",
  "version": "1.0.0",
  "description": "Approve and stop YCoding control of an exact Chrome tab.",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups"],
  "host_permissions": ["http://127.0.0.1/*"],
  "incognito": "not_allowed",
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "YCoding Interaction", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src data:; connect-src ws://127.0.0.1:*; object-src 'none'" }
}
