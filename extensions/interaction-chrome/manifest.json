{
  "manifest_version": 3,
  "name": "YCoding Interaction",
  "version": "1.1.0",
  "description": "Connect Chrome to YCoding on this Mac, approve tab control, and stop it.",
  "key": "",
  "icons": {
    "16": "icons/idle-16.png",
    "32": "icons/idle-32.png",
    "48": "icons/idle-48.png",
    "128": "icons/idle-128.png"
  },
  "permissions": [
    "alarms",
    "debugger",
    "storage",
    "tabs",
    "tabGroups"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "YCoding Interaction",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src data:; connect-src ws://127.0.0.1:*; object-src 'none'"
  }
}
