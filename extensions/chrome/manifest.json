{
  "manifest_version": 3,
  "name": "YCoding",
  "version": "0.1.0",
  "description": "Connects a paired Chrome profile or creates agent-owned background tabs for YCoding.",
  "key": "",
  "permissions": ["alarms", "debugger", "storage", "tabs", "tabGroups"],
  "icons": {
    "16": "icons/ycoding-16.png",
    "32": "icons/ycoding-32.png",
    "48": "icons/ycoding-48.png",
    "128": "icons/ycoding-128.png"
  },
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "YCoding Chrome bridge",
    "default_icon": {
      "16": "icons/ycoding-16.png",
      "32": "icons/ycoding-32.png"
    },
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
