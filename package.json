{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ycoding",
  "description": "YCoding terminal coding agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run --cwd packages/cli --conditions=browser src/index.ts",
    "build:tui": "bun run --cwd packages/cli build:tui --single --outdir=../../dist/tui",
    "build:computer-helper": "bun run --cwd packages/cli build:computer-helper",
    "smoke:tui": "bun run --cwd packages/cli smoke:tui -- --dir=../../dist/tui",
    "smoke:runtime": "bun run --cwd packages/cli smoke:runtime -- --dir=../../dist/tui",
    "refresh:models": "bun run --cwd packages/cli refresh:models",
    "brand:generate": "bun run --cwd packages/simulation brand:generate",
    "check:ycoding-workspace": "bun script/ycoding-workspace.ts",
    "check:ycoding-brand": "bun script/ycoding-residuals.ts",
    "rebrand:ycoding": "bun script/ycoding-rebrand.ts --write",
    "lint": "oxlint",
    "lint:effect-patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/core/src packages/server/src packages/protocol/src packages/cli/src",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "typecheck": "bun turbo typecheck --concurrency=3 --filter='./packages/*'",
    "typecheck:profile": "bun script/profile-typecheck.ts",
    "typecheck:profile:packages": "bun script/profile-typecheck-packages.ts",
    "upgrade-opentui": "bun run script/upgrade-opentui.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "sso": "aws sso login --sso-session=ycoding --no-browser",
    "test": "echo 'do not run tests from root' && exit 1",
    "test:unit:browser": "bun run --cwd packages/core test:unit:browser && bun run --cwd packages/tui test:unit:browser",
    "test:integration:browser": "bun run --cwd packages/core test:integration:browser && bun run --cwd packages/server test:integration:browser && bun run --cwd packages/tui test:integration:browser"
  },
  "workspaces": {
    "packages": [
      "packages/ai",
      "packages/cli",
      "packages/client",
      "packages/codemode",
      "packages/core",
      "packages/effect-drizzle-sqlite",
      "packages/effect-sqlite-node",
      "packages/http-recorder",
      "packages/httpapi-codegen",
      "packages/plugin",
      "packages/protocol",
      "packages/schema",
      "packages/script",
      "packages/server",
      "packages/simulation",
      "packages/tui",
      "packages/ui"
    ],
    "catalog": {
      "@effect/opentelemetry": "4.0.0-beta.98",
      "@effect/platform-node": "4.0.0-beta.98",
      "@effect/sql-sqlite-bun": "4.0.0-beta.98",
      "@types/bun": "1.3.13",
      "@types/cross-spawn": "6.0.6",
      "@opentui/core": "0.5.10",
      "@opentui/keymap": "0.5.10",
      "@opentui/solid": "0.5.10",
      "@shikijs/stream": "4.2.0",
      "@kobalte/core": "0.13.11",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@types/semver": "7.7.1",
      "@tsconfig/node22": "22.0.2",
      "@tsconfig/bun": "1.0.9",
      "@pierre/diffs": "1.2.10",
      "opentui-spinner": "0.0.7",
      "@tailwindcss/vite": "4.1.11",
      "diff": "8.0.2",
      "drizzle-kit": "1.0.0-rc.2",
      "drizzle-orm": "1.0.0-rc.2",
      "effect": "4.0.0-beta.98",
      "cross-spawn": "7.0.6",
      "fuzzysort": "3.1.0",
      "get-east-asian-width": "1.6.0",
      "luxon": "3.6.1",
      "marked": "17.0.6",
      "marked-shiki": "1.2.1",
      "remend": "1.3.0",
      "semver": "7.7.4",
      "typescript": "5.8.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "zod": "4.1.8",
      "remeda": "2.26.0",
      "resolve.exports": "2.0.3",
      "shiki": "4.2.0",
      "solid-list": "0.3.0",
      "string-width": "7.2.0",
      "tailwindcss": "4.1.11",
      "vite": "7.1.4",
      "@solidjs/meta": "0.29.4",
      "solid-js": "1.9.10",
      "vite-plugin-solid": "2.11.10",
      "@lydell/node-pty": "1.2.0-beta.12"
    }
  },
  "devDependencies": {
    "@actions/artifact": "5.0.1",
    "@ast-grep/cli": "0.44.0",
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "glob": "13.0.5",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2",
    "semver": "^7.6.0",
    "turbo": "2.10.2"
  },
  "dependencies": {
    "@ycoding-ai/plugin": "workspace:*",
    "@ycoding-ai/script": "workspace:*",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "node-pty",
    "protobufjs",
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-powershell",
    "web-tree-sitter"
  ],
  "overrides": {
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "solid-js": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:"
  },
  "patchedDependencies": {
    "@ff-labs/fff-bun@0.9.3": "patches/@ff-labs%2Ffff-bun@0.9.3.patch",
    "@npmcli/agent@4.0.2": "patches/@npmcli%2Fagent@4.0.2.patch",
    "@silvia-odwyer/photon-node@0.3.4": "patches/@silvia-odwyer%2Fphoton-node@0.3.4.patch",
    "@standard-community/standard-openapi@0.2.9": "patches/@standard-community%2Fstandard-openapi@0.2.9.patch",
    "solid-js@1.9.10": "patches/solid-js@1.9.10.patch",
    "@ai-sdk/xai@3.0.102": "patches/@ai-sdk%2Fxai@3.0.102.patch",
    "gcp-metadata@8.1.2": "patches/gcp-metadata@8.1.2.patch",
    "pacote@21.5.0": "patches/pacote@21.5.0.patch",
    "@ai-sdk/google@3.0.73": "patches/@ai-sdk%2Fgoogle@3.0.73.patch",
    "@pierre/trees@1.0.0-beta.4": "patches/@pierre%2Ftrees@1.0.0-beta.4.patch",
    "@modelcontextprotocol/sdk@1.29.0": "patches/@modelcontextprotocol%2Fsdk@1.29.0.patch",
    "effect@4.0.0-beta.98": "patches/effect@4.0.0-beta.98.patch",
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch"
  }
}
