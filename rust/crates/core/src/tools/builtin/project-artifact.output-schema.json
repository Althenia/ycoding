{
  "type": "object",
  "properties": {
    "result": { "enum": ["created", "updated", "reconciled", "search"] },
    "kind": { "enum": ["skill", "command", "agent", "plugin"] },
    "id": { "type": "string" },
    "versionID": { "type": "string" },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stage": { "const": "trial" },
    "remaining": {
      "type": "object",
      "properties": {
        "session": { "type": "number" },
        "projectDaily": { "type": "number" },
        "projectArtifacts": { "type": "number" },
        "versions": { "type": "number" },
        "bytes": { "type": "number" }
      },
      "required": ["session", "projectDaily", "projectArtifacts", "versions", "bytes"],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "enum": ["skill", "command", "agent"] },
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "stage": { "enum": ["trial", "active"] },
          "versionID": { "type": "string" },
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["kind", "id", "name", "description", "tags", "stage", "versionID", "contentDigest"],
        "additionalProperties": false
      }
    }
  },
  "required": ["result"],
  "additionalProperties": false
}
