{
  "name": "ycoding-preview",
  "main": "src/preview/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "PREVIEW_ORIGINS": ""
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay",
        "script_name": "ycoding-cloud"
      },
      {
        "name": "PREVIEW_DIRECTORY",
        "class_name": "PreviewDirectory",
        "script_name": "ycoding-cloud"
      }
    ]
  }
}
