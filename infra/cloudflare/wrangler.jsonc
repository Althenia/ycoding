{
  "name": "ycoding-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ycoding.althenia.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/.well-known",
      "/.well-known/*",
      "/ws",
      "/ws/*",
      "/health",
      "/remote",
      "/remote/*",
      "/docs",
      "/docs/*",
      "/changelog",
      "/changelog/*",
      "/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ycoding-prod-db",
      "database_id": "3384fc56-42d6-40a1-af04-5a75bd391132"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_RELAY",
        "class_name": "DeviceRelay"
      }
    ]
  },
  "exports": {
    "DeviceRelay": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "env": {
    "beta": {
      "name": "ycoding-cloud-beta",
      "routes": [
        {
          "pattern": "beta.ycoding.althenia.app",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ycoding-beta-db",
          "database_id": "3f94c84b-4b74-4e9f-af3f-fae112369930"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "DEVICE_RELAY",
            "class_name": "DeviceRelay"
          }
        ]
      }
    }
  }
}
