{
  "package": "ycoding-runtime",
  "targets": [
    {
      "artifact": "darwin-arm64",
      "triple": "aarch64-apple-darwin"
    },
    {
      "artifact": "darwin-x64",
      "triple": "x86_64-apple-darwin"
    },
    {
      "artifact": "linux-x64",
      "triple": "x86_64-unknown-linux-gnu"
    },
    {
      "artifact": "windows-x64",
