  "nested": [
    {
      "crate": "aws-lc-sys",
      "path": "aws-lc/LICENSE",
      "action": "include",
      "reason": "vendored AWS-LC sources are compiled into the binary"
    },
    {
      "crate": "aws-lc-sys",
      "path": "aws-lc/third_party/fiat/LICENSE",
      "action": "include",
      "reason": "vendored fiat-crypto sources are compiled into AWS-LC"
    },
    {
      "crate": "chrono-tz",
      "path": "tz/LICENSE",
      "action": "include",
      "reason": "the tz database is compiled into the binary as timezone data"
    },
    {
      "crate": "image",
      "path": "tests/images/tga/testsuite/LICENSE",
      "action": "exclude",
      "reason": "test images are not part of the library build"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/COPYING",
      "action": "include",
      "reason": "vendored libgit2 is compiled into the binary"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/deps/llhttp/LICENSE-MIT",
      "action": "include",
      "reason": "build.rs compiles libgit2/deps/llhttp"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/deps/pcre2/LICENCE.md",
      "action": "include",
      "reason": "build.rs compiles libgit2/deps/pcre2"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/deps/winhttp/COPYING.GPL",
      "action": "exclude",
      "reason": "winhttp import-library support files are not compiled by build.rs; Windows links the system winhttp"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/deps/winhttp/COPYING.LGPL",
      "action": "exclude",
      "reason": "winhttp import-library support files are not compiled by build.rs; Windows links the system winhttp"
    },
    {
      "crate": "libgit2-sys",
      "path": "libgit2/deps/zlib/LICENSE",
      "action": "exclude",
      "reason": "build.rs links libz-sys instead of the bundled libgit2 zlib"
    },
    {
      "crate": "libsqlite3-sys",
      "path": "sqlcipher/LICENSE",
      "action": "exclude",
      "reason": "SQLCipher sources are used only by the bundled-sqlcipher feature, which is not enabled"
    },
    {
      "crate": "libz-sys",
      "path": "src/zlib/LICENSE",
      "action": "include",
      "reason": "zlib sources are compiled when no system zlib is linked"
    },
    {
      "crate": "libz-sys",
      "path": "src/zlib/contrib/dotzlib/LICENSE_1_0.txt",
      "action": "exclude",
      "reason": "zlib contrib code is not compiled"
    },
    {
      "crate": "libz-sys",
      "path": "src/zlib/contrib/minizip/LICENSE.Info-Zip",
      "action": "exclude",
      "reason": "zlib contrib code is not compiled"
    },
    {
      "crate": "libz-sys",
      "path": "src/zlib-ng/LICENSE.md",
      "action": "exclude",
      "reason": "zlib-ng is used only by the zlib-ng feature, which is not enabled"
    },
    {
      "crate": "lmdb-master-sys",
      "path": "lmdb/libraries/liblmdb/COPYRIGHT",
      "action": "include",
      "reason": "vendored LMDB sources are compiled into the binary"
    },
    {
      "crate": "lmdb-master-sys",
      "path": "lmdb/libraries/liblmdb/LICENSE",
      "action": "include",
      "reason": "vendored LMDB sources are compiled into the binary"
    },
    {
      "crate": "regex-syntax",
      "path": "src/unicode_tables/LICENSE-UNICODE",
      "action": "include",
      "reason": "Unicode tables are compiled into the binary"
    },
    {
      "crate": "ring",
      "path": "src/polyfill/once_cell/LICENSE-APACHE",
      "action": "include",
      "reason": "vendored once_cell code is compiled into ring"
    },
    {
      "crate": "ring",
      "path": "src/polyfill/once_cell/LICENSE-MIT",
      "action": "include",
      "reason": "vendored once_cell code is compiled into ring"
    },
    {
      "crate": "ring",
      "path": "third_party/fiat/LICENSE",
      "action": "include",
      "reason": "vendored fiat-crypto sources are compiled into ring"
    },
    {
      "crate": "tracing-core",
      "path": "src/spin/LICENSE",
      "action": "include",
      "reason": "vendored spin code is compiled into tracing-core"
    }
